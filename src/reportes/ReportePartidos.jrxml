	<queryString language="SQL">
		<![CDATA[SELECT p.UUID_Partido, eq1.Nombre_Equipo AS Nombre_Equipo1, eq2.Nombre_Equipo AS Nombre_Equipo2, p.Fecha_Partido, p.Hora_Partido, p.Marcador_Equipo1, p.Marcador_Equipo2, tp.Tipo_Partido, a.Nombre_Arbitro
FROM tbPartidos p
LEFT JOIN tbEquipos eq1 ON p.UUID_Equipo1 = eq1.UUID_Equipo
LEFT JOIN tbEquipos eq2 ON p.UUID_Equipo2 = eq2.UUID_Equipo
LEFT JOIN tbTipoPartido tp ON p.UUID_Tipo_Partido = tp.UUID_Tipo_Partido
LEFT JOIN tbArbitros a ON p.UUID_Arbitro = a.UUID_Arbitro]]>
	</queryString>
